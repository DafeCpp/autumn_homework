// VS Code settings and extensions for the Ubuntu 24.04 development container.
{
	"name": "C++",
	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			"VARIANT": "ubuntu-24.04"
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/node:2": {"version": "24"}
	},
	"runArgs": [
		"--cap-add=SYS_PTRACE",
		"--security-opt",
		"seccomp=unconfined"
	],
	"customizations": {
		"vscode": {
			"settings": {
				"C_Cpp.formatting": "disabled",
				"clang-format.fallbackStyle": "Google",
				"clang-format.language.cpp.enable": true,
				"clang-format.executable": "/usr/bin/clang-format",
				"editor.formatOnSave": true,
				"[c]": {
					"editor.defaultFormatter": "xaver.clang-format",
					"editor.formatOnSave": true
				},
				"[cpp]": {
					"editor.defaultFormatter": "xaver.clang-format",
					"editor.formatOnSave": true
				},
				"cmake.options.statusBarVisibility": "visible",
				"cmake.options.advanced": {
					"buildTarget": {
						"statusBarVisibility": "visible"
					},
					"launchTarget": {
						"statusBarVisibility": "visible"
					},
					"build": {
						"statusBarVisibility": "icon"
					},
					"debug": {
						"statusBarVisibility": "icon"
					},
					"launch": {
						"statusBarVisibility": "icon"
					}
				},
				"C_Cpp.intelliSenseEngine": "disabled",
				"clang-format.style": "file",
				"clangd.path": "/usr/bin/clangd",
				"clangd.arguments": [
					"--compile-commands-dir=${workspaceFolder}/build"
				],
				"cmake.buildDirectory": "${workspaceFolder}/build",
				"cmake.exportCompileCommandsFile": true
			},
			"extensions": [
				"llvm-vs-code-extensions.vscode-clangd",
				"ms-vscode.cpptools",
				"xaver.clang-format",
				"ms-vscode.cmake-tools"
			]
		}
	},
	"forwardPorts": [8765],
	"portsAttributes": {
		"8765": {"label": "Графы и шаги алгоритма", "onAutoForward": "notify"}
	},
	"remoteUser": "vscode"
}
